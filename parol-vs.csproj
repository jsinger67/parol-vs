<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>

    <!-- VSIX settings -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="CHANGELOG.md" />
    <None Remove="LICENSE-APACHE" />
    <None Remove="LICENSE-MIT" />
    <None Remove="LICENSE.txt" />
    <None Remove="README.md" />
    <None Remove="Resources\parol.png" />
    <None Remove="Resources\ParolVS300x300.png" />
    <None Remove="Resources\ParolVS512x512.png" />
    <None Remove="Resources\Preview.png" />
    <None Remove="Resources\Preview200x200.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="CHANGELOG.md" />
    <Content Include="LICENSE-APACHE" />
    <Content Include="LICENSE-MIT" />
    <Content Include="LICENSE.txt" />
    <Content Include="README.md" />
    <Content Include="Resources\parol.png" />
    <Content Include="Resources\ParolVS300x300.png" />
    <Content Include="Resources\ParolVS512x512.png" />
    <Content Include="Resources\Preview.png" />
    <Content Include="Resources\Preview200x200.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
</Project>
